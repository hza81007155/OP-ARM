# 1. 目标平台与架构配置
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_generic=y

# 2. 编译输出格式（仅生成 rootfs.tar.gz）
CONFIG_TARGET_ROOTFS_TARGZ=y
# 关闭其他输出格式（避免冗余）
CONFIG_TARGET_ROOTFS_SQUASHFS=n
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_ISO=n
CONFIG_TARGET_ROOTFS_JFFS2=n

# 3. 核心系统组件（必须保留）
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_COREFILES=y
CONFIG_FSTOOLS=y
CONFIG_LIBC=y
CONFIG_LINUX=y
CONFIG_MUSL=y
CONFIG_PROCD=y
CONFIG_UBOX=y
CONFIG_UBUS=y
CONFIG_UCI=y
CONFIG_UCODE=y
CONFIG_LOGD=y
CONFIG_JSONC=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_DES_C=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_ENTROPY_FORCE_SHA256=y
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED=y
CONFIG_MBEDTLS_NIST_KW_C=y
CONFIG_MBEDTLS_RSA_NO_CRT=y

# 4. 网络基础功能（必备）
CONFIG_NETIFD=y
CONFIG_DNSMASQ=y          # DNS解析
CONFIG_UDHCPD=y           # DHCP服务
CONFIG_UDHCPC=y           # DHCP客户端
CONFIG_IPTABLES=y         # 基础防火墙
# CONFIG_IP6TABLES=n        # IPv6防火墙（可选，按需开启）

# 5. 基础命令行工具
CONFIG_BASH=n             # 关闭bash，用ash（更小）
CONFIG_ASH=y              # 默认shell
CONFIG_WGET=y             # wget下载工具
CONFIG_CURL=n             # 关闭curl（按需开启）
CONFIG_PING=y             # ping工具
CONFIG_TRACEROUTE=y       # 路由追踪
CONFIG_NETSTAT=y          # 网络状态查看

# 6. 存储与文件系统
CONFIG_MKFS_EXT4=y        # ext4文件系统支持
CONFIG_MKFS_FAT=y         # FAT32支持
CONFIG_MOUNT=y            # 挂载工具
CONFIG_PARTED_MINIMAL=y   # 分区工具（最小化）

# 7. 编译优化（可选）
CONFIG_OPTIMIZE_FOR_PERFORMANCE=y  # 性能优化
CONFIG_CPU_TYPE="cortex-a53"       # 适配armv8通用架构（a53/a72通用）

# 8. 关闭调试与冗余组件（减小体积）
CONFIG_DEBUG=n
CONFIG_KERNEL_DEBUG=n
CONFIG_KERNEL_DEBUG_FS=n
CONFIG_PACKAGE_kmod-usb=n          # 无USB可关闭
CONFIG_PACKAGE_kmod-bluetooth=n    # 无蓝牙可关闭
# CONFIG_PACKAGE_luci=n              # 关闭LuCI web界面（按需开启）

# 9. 版本与编译参数
CONFIG_VERSIONOPT=y
CONFIG_VERSION_NICK="armsr-armv8-rootfs"
CONFIG_CCACHE=n  # 关闭ccache（首次编译无需）

# APP
ONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-passwall2=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Brook is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Hysteria=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_IPv6_Nat is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_NaiveProxy is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Client=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Server is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_tuic_client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y

# 4. Themes
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# CONFIG_PACKAGE_luci-theme-argon-mod is not set
# CONFIG_PACKAGE_luci-theme-atmaterial_new is not set
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-design is not set

# ssh
CONFIG_PACKAGE_openssh-sftp-server=y
