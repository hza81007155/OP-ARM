# 1. 基础架构与目标配置
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_GENERIC=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_armsr_armv8_DEVICE_generic=y

# 2. 核心系统参数（精简版）
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_KERNEL_BUILD_USER="LEDE"
CONFIG_KERNEL_BUILD_DOMAIN="local"
CONFIG_SHADOW_PASSWORDS=y          
CONFIG_USE_MUSL=y                  
CONFIG_DEVEL=y
CONFIG_CCACHE=y                   
CONFIG_SIGNED_PACKAGES=n           
CONFIG_STRIP_KERNEL_EXPORTS=y      
CONFIG_USE_STRIP=y                 

# 3. 核心系统组件（仅保留必要项）
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y           
CONFIG_PACKAGE_dropbear=y          
CONFIG_PACKAGE_opkg=y              
CONFIG_PACKAGE_uci=y              
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_logd=y              
CONFIG_PACKAGE_netifd=y            
CONFIG_PACKAGE_firewall=y        
CONFIG_PACKAGE_dnsmasq=y           
CONFIG_PACKAGE_ca-certificates=y   
CONFIG_PACKAGE_odhcp6c=y           
CONFIG_PACKAGE_odhcpd-ipv6only=n   

# 4. 核心驱动（通用ARMv8适配）
CONFIG_PACKAGE_kmod-usb-core=y     
CONFIG_PACKAGE_kmod-usb2=y         
CONFIG_PACKAGE_kmod-usb3=y         
CONFIG_PACKAGE_kmod-usb-storage=y  
CONFIG_PACKAGE_kmod-nft-core=y     
CONFIG_PACKAGE_kmod-leds-gpio=y    
CONFIG_PACKAGE_kmod-tun=y         
CONFIG_PACKAGE_kmod-ipt-nat6=n    
CONFIG_PACKAGE_kmod-ipv6=n         

# 5. LuCI Web管理界面（极简版）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y  
CONFIG_PACKAGE_luci-proto-ipv4=y
CONFIG_PACKAGE_luci-proto-ppp=y    
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y 
CONFIG_PACKAGE_luci-app-firewall=y 
CONFIG_PACKAGE_luci-app-opkg=y     

# 6. 基础网络工具（精简）
CONFIG_PACKAGE_ip-full=y           
CONFIG_PACKAGE_ethtool=y           
CONFIG_PACKAGE_wget-ssl=y          
CONFIG_PACKAGE_curl=y              
CONFIG_PACKAGE_iptables-nft=y     
CONFIG_PACKAGE_sshd=n              

# 7. 输出格式（生成rootfs.tar.gz）
CONFIG_TARGET_ROOTFS_TARGZ=y       
CONFIG_TARGET_ROOTFS_SQUASHFS=n   
CONFIG_TARGET_ROOTFS_EXT4=n       
CONFIG_TARGET_ROOTFS_SIZE=1024     
CONFIG_TARGET_PER_DEVICE_ROOTFS=n  

# 8. 移除冗余组件（关键精简项）
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_bluetooth=n
CONFIG_PACKAGE_kmod-bluetooth=n
CONFIG_PACKAGE_samba4=n
CONFIG_PACKAGE_kmod-sound-core=n
CONFIG_PACKAGE_printer=n
CONFIG_PACKAGE_kmod-usb-printer=n

# APP
ONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-passwall2=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Brook is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Hysteria=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_IPv6_Nat is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_NaiveProxy is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Client=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Server is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_tuic_client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y

# 4. Themes
CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-theme-argon-mod is not set
# CONFIG_PACKAGE_luci-theme-atmaterial_new is not set
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-design is not set
